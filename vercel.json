{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm run build:vercel:function && pnpm run build:vercel",
  "outputDirectory": "dist/public",
  "functions": {
    "api/trpc/[...path].js": {
      "includeFiles": "drizzle/neon/**"
    }
  },
  "rewrites": [
    {
      "source": "/:path((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
