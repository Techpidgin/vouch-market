{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm run db:migrate && pnpm run build:vercel",
  "outputDirectory": "dist/public",
  "functions": {
    "api/trpc/[...path].ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/:path((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
